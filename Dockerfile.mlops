FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /workspace

COPY requirements.txt requirements-mlops.txt ./
RUN python -m pip install --upgrade pip && \
    pip install -r requirements-mlops.txt

COPY . .

RUN groupadd --system mlops && \
    useradd --system --gid mlops --home-dir /nonexistent --shell /usr/sbin/nologin mlops && \
    chown -R mlops:mlops /workspace

USER mlops

CMD ["python", "scripts/run_ml_experiment.py"]
