# Application
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-separate-long-random-jwt-secret
LOG_LEVEL=INFO

# Persistence. SQLite remains available for local development.
DATABASE_URL=sqlite:///soc.db
# Production example:
# DATABASE_URL=postgresql+psycopg://soc:soc@postgres:5432/soc

# Shared state. Configure Redis in multi-worker / production deployments.
# REDIS_URL=redis://redis:6379/0

# Trust X-Forwarded-For only when running behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=false

# Real-time client origins. Comma-separated.
SOCKETIO_CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# Optional in development. Required (32+ chars) when APP_ENV=production.
ML_API_KEY=replace-with-a-random-ingestion-key

# Distributed when REDIS_URL is configured; in-memory fallback is development-only.
ML_RATE_LIMIT=300
ML_RATE_WINDOW_SECONDS=60

# Event ingestion mode: direct preserves synchronous scoring; kafka queues for workers.
EVENT_INGEST_MODE=direct
# Required when EVENT_INGEST_MODE=kafka.
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EVENT_TOPIC=soc.events.v1
KAFKA_DLQ_TOPIC=soc.events.dlq.v1
KAFKA_CONSUMER_GROUP=soc-detector-v1

# Optional OpenTelemetry OTLP/HTTP exporter. Leave unset to disable tracing.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_SERVICE_NAME=soc-intrusion-detection
